# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_TUTOR_DAILY_TURN_LIMIT=10

# Railway Cron 內部端點保護（自訂一組隨機字串即可，例如 openssl rand -hex 32）
INTERNAL_CRON_SECRET=

# 每日挑戰推播總開關（預設 true）。設成 false 可以在不動 Cron Schedule／Custom Start
# Command 的情況下暫停整個推播功能，之後在 Railway「每日挑戰推播」服務的 Variables
# 頁面直接切換即可，不用重新部署、也不用改 Cron 設定。
DAILY_PUSH_ENABLED=true

# Gmail SMTP（新使用者待審核通知信；GMAIL_APP_PASSWORD 是 Google 帳戶「應用程式密碼」，
# 不是登入密碼，需要先開啟兩步驟驗證才能產生）
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# 開通成功時附上的操作說明圖（公開 https 網址、PNG/JPEG、≤1MB）；留空則只回文字
GUIDE_IMAGE_URL=
